APP_NAME=Snoodle
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=snoodle
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Google Maps JavaScript API key (address autocomplete / map widgets).
GOOGLE_MAPS_API_KEY=

# Invoice / company letterhead details printed on generated PDFs.
INVOICE_NAME=
INVOICE_ADDRESS1=
INVOICE_ADDRESS2=
INVOICE_ADDRESS3=
INVOICE_PHONE=
INVOICE_SSM=

# wkhtmltopdf / wkhtmltoimage binaries used by snappy for PDF generation.
WKHTML_PDF_BINARY=
WKHTML_IMG_BINARY=

# Xero accounting integration (OAuth2 app credentials + tenant).
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_TENANT_ID=

# Malaysia MyInvois / LHDN e-invoice integration.
E_INVOICE_ENABLED=false
MYINVOIS_CLIENT_ID=
MYINVOIS_CLIENT_SECRET=
MYINVOIS_API_URL=https://api.myinvois.hasil.gov.my
MYINVOIS_PORTAL_URL=https://myinvois.hasil.gov.my

# Shared secret for POST /api/v1/app/version (mobile release build hook).
DEPLOY_VERSION_TOKEN=

# AutoCount plugin sync (snoodle-autocount).
# Shared secret for POST /api/v1/autocount/* — must match OmsApiToken in the
# plugin's App.config. Optional: config/services.php falls back to the value
# shipped with the plugin, so the integration works even if this is unset.
AUTOCOUNT_API_TOKEN=

# Dry run: when true, POST /api/v1/autocount/* logs the received request to the
# `autocount` channel and returns success WITHOUT writing any data. Lets a
# developer inspect what the plugin sends on a live server without mutating the
# database. Leave false (or unset) in normal operation.
AUTOCOUNT_DRY_RUN=true
